rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null && request.auth.token.email is string; }
    function email() { return request.auth.token.email.lower(); }
    function profileRef() { return /databases/$(database)/documents/users/$(email()); }
    function superadmin() {
      return signed() && (
        request.auth.token.superadmin == true ||
        (request.auth.token.email_verified == true && email() == 'jossiefreitas.jgf@gmail.com')
      );
    }
    function active() {
      return signed() && exists(profileRef()) && get(profileRef()).data.status == 'Ativo'
        && get(profileRef()).data.email == email();
    }
    function role() { return get(profileRef()).data.role; }
    function clinic() { return get(profileRef()).data.clinicId; }
    function staff() { return active() && role() in ['Admin','Fisio','Recepcao']; }
    function clinical() { return active() && role() in ['Admin','Fisio']; }
    function admin() { return active() && role() == 'Admin'; }
    function tenant(data) { return data.clinicId is string && active() && data.clinicId == clinic(); }
    function staffCreate() { return superadmin() || (staff() && tenant(request.resource.data)); }
    function staffUpdate() {
      return superadmin() || (staff() && tenant(resource.data) && tenant(request.resource.data)
        && request.resource.data.clinicId == resource.data.clinicId);
    }
    function staffDelete() { return superadmin() || (staff() && tenant(resource.data)); }
    function patientMatches(data) {
      return data.patientId is string
        && exists(/databases/$(database)/documents/patients/$(data.patientId))
        && get(/databases/$(database)/documents/patients/$(data.patientId)).data.clinicId == data.clinicId;
    }
    function eventMatches(data) {
      return data.eventId is string
        && exists(/databases/$(database)/documents/events/$(data.eventId))
        && get(/databases/$(database)/documents/events/$(data.eventId)).data.clinicId == data.clinicId;
    }
    function confidentialRead() { return superadmin() || (clinical() && tenant(resource.data)); }
    function confidentialWrite() {
      return superadmin() || (clinical() && tenant(request.resource.data)
        && (resource == null || (tenant(resource.data) && resource.data.clinicId == request.resource.data.clinicId)));
    }
    match /clinics/{clinicId} {
      allow get: if superadmin() || (active() && clinicId == clinic());
      allow list, create, update, delete: if superadmin();
    }
    match /users/{userEmail} {
      allow get: if superadmin() || (signed() && userEmail == email())
        || (admin() && tenant(resource.data));
      allow list: if superadmin() || (admin() && tenant(resource.data));
      // Provisioning and role creation must happen via Admin SDK, not the browser.
      allow create, delete: if false;
      allow update: if superadmin() || (
        admin() && tenant(resource.data) && request.resource.data.clinicId == resource.data.clinicId
        && request.resource.data.email == resource.data.email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','status','role'])
        && request.resource.data.role in ['Admin','Fisio','Recepcao']
        && !('password' in request.resource.data)
      );
    }
    match /patients/{id} {
      allow get, list: if superadmin() || (staff() && tenant(resource.data));
      allow create: if staffCreate();
      allow update: if staffUpdate();
      allow delete: if false; // archive instead; deletion requires deliberate admin migration
    }
    match /events/{id} {
      allow get, list: if superadmin() || (staff() && tenant(resource.data));
      allow create: if staffCreate() && (superadmin() || admin());
      allow update: if staffUpdate() && (superadmin() || admin());
      allow delete: if staffDelete() && (superadmin() || admin());
    }
    match /registrations/{id} {
      allow get, list: if superadmin() || (staff() && tenant(resource.data));
      allow create: if staffCreate() && patientMatches(request.resource.data) && eventMatches(request.resource.data);
      allow update: if staffUpdate() && patientMatches(request.resource.data) && eventMatches(request.resource.data);
      allow delete: if staffDelete() && (superadmin() || admin());
    }
    match /attendances/{id} {
      allow get, list: if superadmin() || (staff() && tenant(resource.data));
      allow create: if staffCreate() && patientMatches(request.resource.data) && eventMatches(request.resource.data);
      allow update: if staffUpdate() && patientMatches(request.resource.data) && eventMatches(request.resource.data);
      allow delete: if staffDelete() && (superadmin() || admin());
    }
    match /appointments/{id} {
      allow get, list: if superadmin() || (staff() && tenant(resource.data));
      allow create: if staffCreate() && patientMatches(request.resource.data);
      allow update: if staffUpdate() && patientMatches(request.resource.data);
      allow delete: if staffDelete() && (superadmin() || admin());
    }
    match /assessments/{id} {
      allow get, list: if confidentialRead();
      allow create: if confidentialWrite() && patientMatches(request.resource.data);
      allow update: if confidentialWrite() && patientMatches(request.resource.data);
      allow delete: if false;
    }
    match /medicalRecords/{id} {
      allow get, list: if confidentialRead();
      allow create: if confidentialWrite() && patientMatches(request.resource.data);
      allow update: if confidentialWrite() && patientMatches(request.resource.data);
      allow delete: if false;
    }
    match /transactions/{id} {
      allow get, list: if superadmin() || (admin() && tenant(resource.data));
      allow create: if superadmin() || (admin() && tenant(request.resource.data));
      allow update: if superadmin() || (admin() && tenant(resource.data)
        && tenant(request.resource.data) && resource.data.clinicId == request.resource.data.clinicId);
      allow delete: if superadmin() || (admin() && tenant(resource.data));
    }
    match /{document=**} { allow read, write: if false; }
  }
}
