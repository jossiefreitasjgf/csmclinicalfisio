# Firebase web config is sourced from firebase-applet-config.json (public IDs only).
# Authentication requires Email/Password enabled and profile provisioned with the Admin CLI.
PORT=3000
# Server-side AI feature (optional). Never use VITE_ prefix for secrets.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Service Account credentials MUST be stored outside this project and never put into the zip.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-service-account.json
# FIREBASE_PROJECT_ID=zany-tribute-fw2h4
# CORS_ORIGIN=https://seu-frontend.vercel.app
# VITE_API_URL=https://seu-backend.onrender.com
